# Served by Apache on cPanel. Astro copies this file into dist/ on build.
# Prefer the static site over any leftover WordPress index.php.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: www.gamenock.com was serving the same site as an
  # uncanonicalized duplicate, letting search engines index it separately.
  RewriteCond %{HTTP_HOST} ^www\.gamenock\.com$ [NC]
  RewriteRule ^(.*)$ https://gamenock.com/$1 [R=301,L]

  # Old case-study URLs (Gamisodes was removed from the site)
  RewriteRule ^work/gamisodes-baby-einstein/?$ /work/ [R=301,L]
  RewriteRule ^work/gamisodes/?$ /work/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS: the site is already all-HTTPS (Cloudflare + the www redirect above),
  # so this just tells browsers to skip the plain-HTTP round trip entirely on
  # repeat visits. No "preload" -- submitting to the browser preload list is a
  # much harder commitment to reverse and should be an explicit separate choice.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # SAMEORIGIN (not DENY) since nothing here needs framing itself, but this
  # keeps the option open without weakening clickjacking protection any.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Matches what this site actually loads (checked against every source file,
  # plus what Cloudflare itself injects at the edge -- its Web Analytics beacon
  # script wasn't in any source file and only showed up once this was live,
  # blocked, so static.cloudflareinsights.com is allowed for that reason
  # specifically, not because the site's own code references it).
  # Google Fonts (style+font), the backend API (fetch), and inline <script>/style
  # -- 'unsafe-inline' is required for both because the site ships inline
  # JSON-LD (schema.org scripts) and inline style="" attributes throughout the
  # markup; removing either would break real functionality, not just tighten
  # security. object-src/frame-ancestors are locked down since nothing here
  # uses plugins or expects to be framed.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.gamenock.com https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

  # public/js/site.js is the one file actually overwritten in place on every
  # deploy at a stable URL, so it still needs to revalidate on every request
  # or some visitors would keep running a stale copy after a deploy.
  <If "%{REQUEST_URI} =~ m#^/js/#">
    Header set Cache-Control "no-cache"
  </If>

  # public/img/ (game key art etc.) is never overwritten in place in practice --
  # new art always ships under a new filename -- so there's no real staleness
  # risk here. It was previously grouped with /js/ under "no-cache", which
  # forced Cloudflare to revalidate every image against the origin on every
  # request instead of serving them from its edge cache, adding a full
  # origin round-trip to nearly every page load. Cache them like /assets/*.
  <If "%{REQUEST_URI} =~ m#^/img/#">
    Header set Cache-Control "public, max-age=604800"
  </If>

  # Astro's build output at /assets/* is content-hashed (a filename changes
  # whenever its content does), so it's always safe to cache for as long as
  # possible instead of leaving it to browser heuristics.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

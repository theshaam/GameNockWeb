# Served by Apache on cPanel. Astro copies this file into dist/ on build.
# Prefer the static site over any leftover WordPress index.php.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Old case-study URL
  RewriteRule ^work/gamisodes-baby-einstein/?$ /work/gamisodes/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Served by Apache on cPanel. Astro copies this file into dist/ on build.
# Prefer the static site over any leftover WordPress index.php.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: www.gamenock.com was serving the same site as an
  # uncanonicalized duplicate, letting search engines index it separately.
  RewriteCond %{HTTP_HOST} ^www\.gamenock\.com$ [NC]
  RewriteRule ^(.*)$ https://gamenock.com/$1 [R=301,L]

  # Old case-study URLs (Gamisodes was removed from the site)
  RewriteRule ^work/gamisodes-baby-einstein/?$ /work/ [R=301,L]
  RewriteRule ^work/gamisodes/?$ /work/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # public/js/site.js is the one file actually overwritten in place on every
  # deploy at a stable URL, so it still needs to revalidate on every request
  # or some visitors would keep running a stale copy after a deploy.
  <If "%{REQUEST_URI} =~ m#^/js/#">
    Header set Cache-Control "no-cache"
  </If>

  # public/img/ (game key art etc.) is never overwritten in place in practice --
  # new art always ships under a new filename -- so there's no real staleness
  # risk here. It was previously grouped with /js/ under "no-cache", which
  # forced Cloudflare to revalidate every image against the origin on every
  # request instead of serving them from its edge cache, adding a full
  # origin round-trip to nearly every page load. Cache them like /assets/*.
  <If "%{REQUEST_URI} =~ m#^/img/#">
    Header set Cache-Control "public, max-age=604800"
  </If>

  # Astro's build output at /assets/* is content-hashed (a filename changes
  # whenever its content does), so it's always safe to cache for as long as
  # possible instead of leaving it to browser heuristics.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

---
interface Props { items: [string, string][] }
const { items } = Astro.props;
const site = Astro.site ?? new URL('https://gamenock.com');
const trail = [['/', 'Home'], ...items] as [string, string][];
const ld = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: trail.map(([href, name], i) => ({
  '@type': 'ListItem', position: i + 1, name, item: new URL(href, site).href
})) };
---
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a>{items.map(([href, t], i) => (
  <Fragment><span aria-hidden="true">/</span>{i === items.length - 1 ? <span aria-current="page">{t}</span> : <a href={href}>{t}</a>}</Fragment>
))}</nav>

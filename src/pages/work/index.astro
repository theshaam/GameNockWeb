---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Crumbs from '../../components/Crumbs.astro';
import Sec from '../../components/Sec.astro';
import CaseCard from '../../components/CaseCard.astro';
import others from '../../data/other-projects.json';

const cases = (await getCollection('work')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const imgs = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/0[4-7]-*.webp', { eager: true });
const chips = [['all', 'All'], ['mobile', 'Mobile'], ['multiplayer', 'Multiplayer'], ['backend', 'Backend & live services']];
---
<Layout title="Work and Case Studies | Game Nock" description="Game development case studies from Game Nock, including Gamisodes / Baby Einstein, HighNoon and Blast Wheels." active="work">
<section class="pg-hero"><div class="wrap"><Crumbs items={[['/work/', 'Work']]} /><span class="eyebrow">Work</span><h1>Games We Have Helped Build.</h1><p class="lede">Each case study explains the project, the problem and exactly what Game Nock was responsible for.</p></div></section>
<Sec>
  <div class="fchips" data-for="casegrid" role="group" aria-label="Filter projects">{chips.map(([f, t]) => <button type="button" data-f={f} aria-pressed={String(f === 'all')}>{t}</button>)}</div>
  <div class="g3" id="casegrid">{cases.map(e => <CaseCard entry={e} h="h2" />)}</div>
</Sec>
<Sec eyebrow="More projects" title="Additional Work" lede="Full case studies for these projects are being prepared.">
  <div class="g3" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr))">{others.map(o => (
    <div class="glass ccard"><div class="ci"><Picture src={imgs[`../../assets/img/${o.img}`].default} formats={['avif', 'webp']} fallbackFormat="webp" widths={[320, 640]} sizes="(max-width: 700px) 92vw, 300px" loading="lazy" decoding="async" alt={`${o.name} key art`} /></div><div class="cb"><h3 style="font-size:20px;margin:0 0 6px">{o.name}</h3><p class="soon">Case study in preparation.</p></div></div>
  ))}</div>
</Sec>
</Layout>

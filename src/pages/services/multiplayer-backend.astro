---
import Layout from '../../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import i_02_highnoon from '../../assets/img/02-highnoon.webp';
import i_03_blast_wheels from '../../assets/img/03-blast-wheels.webp';
---
<Layout title={"Multiplayer & Backend | Game Nock"} description={"Multiplayer and backend development for Unity games with Photon Fusion, PUN2, PlayFab, Firebase and Node.js."} active="services" contact={true}>
<section class="pg-hero"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/services/">Services</a><span aria-hidden="true">/</span><span aria-current="page">Multiplayer &amp; Backend</span></nav><span class="eyebrow">Multiplayer & Backend</span><h1>Multiplayer and Backend Systems That Hold Up in Production.</h1><p class="lede">Real-time multiplayer, player services and live-game backends for Unity projects.</p><div class="ctas"><button class="btn btn-primary mag" data-contact>Discuss Your Project <svg><use href="#arrow"/></svg></button><a class="btn btn-wa-solid" href="https://wa.me/923184142473" target="_blank" rel="noopener"><svg><use href="#whatsapp"/></svg> Chat on WhatsApp</a></div></div></section><section class="sp "><div class="wrap"><div class="g2"><div class="glass"><span class="eyebrow">Problems we solve</span><h2 class="ttl">When Teams Call Us</h2><ul class="facts"><li>Your game needs real-time or turn-based multiplayer</li><li>Player accounts, inventories or economies need a backend</li><li>An existing multiplayer mode is unstable or hard to scale</li><li>Live content, events or leaderboards need a service layer</li></ul></div>
      <div class="glass"><span class="eyebrow">Deliverables</span><h2 class="ttl">What You Receive</h2><ul class="facts"><li>Multiplayer architecture and netcode</li><li>Matchmaking and lobbies</li><li>Player accounts and authentication</li><li>Economy, inventory and purchase validation</li><li>Leaderboards and live events</li><li>Analytics and attribution integration</li><li>Load and stability testing</li></ul></div></div></div></section><section class="sp "><div class="wrap"><div class="g2"><div class="glass"><span class="eyebrow">Project stages</span><h2 class="ttl">Where This Fits</h2><ul class="facts"><li>Planning a multiplayer game</li><li>Adding online features to an existing game</li><li>Stabilising multiplayer before launch</li></ul></div>
      <div class="glass"><span class="eyebrow">Technologies</span><h2 class="ttl">What We Use</h2><table class="tbl"><tbody><tr><th scope="row">Multiplayer</th><td>Photon Fusion, PUN2, Photon Voice</td></tr><tr><th scope="row">Backend</th><td>PlayFab, Firebase, Node.js, Supabase</td></tr><tr><th scope="row">Analytics</th><td>AppsFlyer, Tenjin</td></tr><tr><th scope="row">Web3</th><td>Sui, Move, thirdweb, ChainSafe</td></tr></tbody></table></div></div></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">Process</span><h2>How We Deliver</h2></div><ol class="ksteps"><li class="glass"><h3>Review</h3><p>We study your project and goals.</p></li><li class="glass"><h3>Plan</h3><p>Scope, team, milestones and risks.</p></li><li class="glass"><h3>Build</h3><p>Iterative development with regular builds.</p></li><li class="glass"><h3>Test</h3><p>QA on target devices.</p></li><li class="glass"><h3>Deliver</h3><p>Release, handover and support.</p></li></ol><p style="margin-top:24px"><a class="link" href="/how-we-work/">See the full process <svg><use href="#arrow"/></svg></a></p></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">Related work</span><h2>Projects Where We Did This</h2></div><div class="g3"><a class="glass ccard" href="/work/highnoon/" data-tags="mobile multiplayer backend"><div class="ci"><Picture src={i_02_highnoon} formats={["avif","webp"]} fallbackFormat="webp" widths={[400, 720, 1080]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 560px" loading="lazy" decoding="async" alt="HighNoon key art" /></div>
  <div class="cb"><div class="tags"><span class="tag2">Mobile competitive game</span><span class="tag2">Mobile</span></div><h3 style="font-size:22px;margin:0 0 10px">HighNoon</h3><ul class="facts"><li>Real-time 1v1 multiplayer</li><li>PlayFab services</li><li>In-app purchases and advertising</li></ul><span class="more">View case study <svg><use href="#arrow"/></svg></span></div></a><a class="glass ccard" href="/work/blast-wheels/" data-tags="multiplayer backend"><div class="ci"><Picture src={i_03_blast_wheels} formats={["avif","webp"]} fallbackFormat="webp" widths={[400, 720, 1080]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 560px" loading="lazy" decoding="async" alt="Blast Wheels key art" /></div>
  <div class="cb"><div class="tags"><span class="tag2">Vehicle combat game</span></div><h3 style="font-size:22px;margin:0 0 10px">Blast Wheels</h3><ul class="facts"><li>PvP and PvE vehicle gameplay</li><li>Unity development</li><li>Sui blockchain with Move and Node</li></ul><span class="more">View case study <svg><use href="#arrow"/></svg></span></div></a></div></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">FAQ</span><h2>Common Questions</h2></div><div class="faq"><details class="glass"><summary>Photon Fusion or PUN?</summary><p>Fusion suits new projects that need modern netcode and larger player counts. PUN still works well for simpler room-based games. We recommend one after reviewing your design.</p></details><details class="glass"><summary>Can you work with our existing backend?</summary><p>Yes. We can extend your services or integrate the game with them.</p></details><details class="glass"><summary>Do you handle Web3 features?</summary><p>When a project needs them. We have integrated Sui with Move and Node.js, but we keep blockchain logic separate from core gameplay.</p></details></div></div></section>
</Layout>

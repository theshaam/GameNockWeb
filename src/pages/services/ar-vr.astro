<Layout title={"AR/VR Development | Game Nock"} description={"AR and VR development in Unity for Meta Quest and mobile AR."} active="services" contact={true}>
<section class="pg-hero"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/services/">Services</a><span aria-hidden="true">/</span><span aria-current="page">AR/VR Development</span></nav><span class="eyebrow">AR/VR Development</span><h1>AR and VR Development in Unity.</h1><p class="lede">Interactive experiences for Meta Quest and mobile AR, built with the same production discipline as our games.</p><div class="ctas"><button class="btn btn-primary mag" data-contact>Discuss Your Project <svg><use href="#arrow"/></svg></button><a class="btn btn-wa-solid" href="https://wa.me/923184142473" target="_blank" rel="noopener"><svg><use href="#whatsapp"/></svg> Chat on WhatsApp</a></div></div></section><section class="sp "><div class="wrap"><div class="g2"><div class="glass"><span class="eyebrow">Problems we solve</span><h2 class="ttl">When Teams Call Us</h2><ul class="facts"><li>You want to bring a game or experience to Meta Quest</li><li>An AR feature needs to work reliably on phones</li><li>A VR prototype needs to become a finished product</li></ul></div>
      <div class="glass"><span class="eyebrow">Deliverables</span><h2 class="ttl">What You Receive</h2><ul class="facts"><li>Interaction design and prototyping</li><li>VR locomotion and comfort settings</li><li>Hand and controller input</li><li>Mobile AR placement and tracking</li><li>Performance tuning for standalone headsets</li><li>Store preparation</li></ul></div></div></div></section><section class="sp "><div class="wrap"><div class="g2"><div class="glass"><span class="eyebrow">Project stages</span><h2 class="ttl">Where This Fits</h2><ul class="facts"><li>Prototype or proof of concept</li><li>Production of a Quest or AR title</li></ul></div>
      <div class="glass"><span class="eyebrow">Technologies</span><h2 class="ttl">What We Use</h2><table class="tbl"><tbody><tr><th scope="row">Engine</th><td>Unity</td></tr><tr><th scope="row">Platforms</th><td>Meta Quest, iOS and Android AR</td></tr><tr><th scope="row">Frameworks</th><td>XR Interaction Toolkit, AR Foundation</td></tr></tbody></table></div></div></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">Process</span><h2>How We Deliver</h2></div><ol class="ksteps"><li class="glass"><h3>Review</h3><p>We study your project and goals.</p></li><li class="glass"><h3>Plan</h3><p>Scope, team, milestones and risks.</p></li><li class="glass"><h3>Build</h3><p>Iterative development with regular builds.</p></li><li class="glass"><h3>Test</h3><p>QA on target devices.</p></li><li class="glass"><h3>Deliver</h3><p>Release, handover and support.</p></li></ol><p style="margin-top:24px"><a class="link" href="/how-we-work/">See the full process <svg><use href="#arrow"/></svg></a></p></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">FAQ</span><h2>Common Questions</h2></div><div class="faq"><details class="glass"><summary>Can you port our existing game to VR?</summary><p>Sometimes. VR needs different controls and comfort design, so we start with a short review of what would need to change.</p></details></div></div></section>
</Layout>

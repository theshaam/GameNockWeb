---
import Layout from '../../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import i_02_highnoon from '../../assets/img/02-highnoon.webp';
import i_03_blast_wheels from '../../assets/img/03-blast-wheels.webp';
import i_portal_codev from '../../assets/img/portal-codev.webp';
import i_portal_complete from '../../assets/img/portal-complete.webp';
import i_portal_specialized from '../../assets/img/portal-specialized.webp';
---
<Layout title={"Game Development Services | Game Nock"} description={"Complete game development, co-development, multiplayer and backend, mobile and WebGL, porting and optimisation, and AR/VR development in Unity."} active="services" contact={true}>
<section class="pg-hero"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Services</span></nav><span class="eyebrow">Services</span><h1>Development Support Built Around Your Project.</h1><p class="lede">Game Nock can own an entire production, extend your internal team or solve a specific technical problem. Start with the path that matches where you are.</p><div class="ctas"><button class="btn btn-primary mag" data-contact>Discuss Your Project <svg><use href="#arrow"/></svg></button><a class="btn btn-wa-solid" href="https://wa.me/923184142473" target="_blank" rel="noopener"><svg><use href="#whatsapp"/></svg> Chat on WhatsApp</a></div></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">Where to start</span><h2>Three Ways We Can Help</h2></div><div class="g3"><a class="glass ccard" href="/services/complete-game-development/"><div class="ci" style="aspect-ratio:16/11;background:radial-gradient(circle at 50% 60%,rgba(90,120,255,.25),transparent 70%)"><Picture src={i_portal_complete} formats={["avif","webp"]} fallbackFormat="webp" widths={[300, 600]} sizes="(max-width: 700px) 60vw, 300px" loading="lazy" decoding="async" alt="" style="object-fit:contain" /></div>
      <div class="cb"><span class="eyebrow">Complete development</span><h3>Build my complete game</h3><p>We plan, staff and manage production through launch.</p><span class="more">Start here <svg><use href="#arrow"/></svg></span></div></a><a class="glass ccard" href="/services/co-development/"><div class="ci" style="aspect-ratio:16/11;background:radial-gradient(circle at 50% 60%,rgba(90,120,255,.25),transparent 70%)"><Picture src={i_portal_codev} formats={["avif","webp"]} fallbackFormat="webp" widths={[300, 600]} sizes="(max-width: 700px) 60vw, 300px" loading="lazy" decoding="async" alt="" style="object-fit:contain" /></div>
      <div class="cb"><span class="eyebrow">Co-development</span><h3>Extend my development team</h3><p>Specialists or a feature team working inside your pipeline.</p><span class="more">Start here <svg><use href="#arrow"/></svg></span></div></a><a class="glass ccard" href="/services/multiplayer-backend/"><div class="ci" style="aspect-ratio:16/11;background:radial-gradient(circle at 50% 60%,rgba(90,120,255,.25),transparent 70%)"><Picture src={i_portal_specialized} formats={["avif","webp"]} fallbackFormat="webp" widths={[300, 600]} sizes="(max-width: 700px) 60vw, 300px" loading="lazy" decoding="async" alt="" style="object-fit:contain" /></div>
      <div class="cb"><span class="eyebrow">Specialised engineering</span><h3>Solve a technical challenge</h3><p>Multiplayer, backend, optimisation or platform delivery.</p><span class="more">Start here <svg><use href="#arrow"/></svg></span></div></a></div></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">All services</span><h2>What We Offer</h2></div><div class="g4"><a class="glass" href="/services/complete-game-development/"><span class="gic"><svg><use href="#pad"/></svg></span><h3>Complete Game Development</h3><p>We assemble and manage the team that takes your approved concept to launch.</p><span class="more">Learn more <svg><use href="#arrow"/></svg></span></a><a class="glass" href="/services/co-development/"><span class="gic"><svg><use href="#team"/></svg></span><h3>Co-Development</h3><p>Specialists and feature teams who work inside your production and pipeline.</p><span class="more">Learn more <svg><use href="#arrow"/></svg></span></a><a class="glass" href="/services/multiplayer-backend/"><span class="gic"><svg><use href="#server"/></svg></span><h3>Multiplayer & Backend</h3><p>Real-time multiplayer, player services and live-game backends.</p><span class="more">Learn more <svg><use href="#arrow"/></svg></span></a><a class="glass" href="/services/mobile-webgl/"><span class="gic"><svg><use href="#phone"/></svg></span><h3>Mobile & WebGL</h3><p>Unity games built and tuned for iOS, Android and the browser.</p><span class="more">Learn more <svg><use href="#arrow"/></svg></span></a><a class="glass" href="/services/porting-optimization/"><span class="gic"><svg><use href="#port"/></svg></span><h3>Porting & Optimization</h3><p>Frame-rate, memory, load-time and platform delivery work on existing games.</p><span class="more">Learn more <svg><use href="#arrow"/></svg></span></a><a class="glass" href="/services/ar-vr/"><span class="gic"><svg><use href="#vr"/></svg></span><h3>AR/VR Development</h3><p>Unity experiences for Meta Quest and mobile AR.</p><span class="more">Learn more <svg><use href="#arrow"/></svg></span></a><a class="glass" href="/work/blast-wheels/"><span class="gic"><svg><use href="#chain"/></svg></span><h3>Web3 Integration</h3><p>On-chain features on Sui with Move, thirdweb and ChainSafe, kept separate from core gameplay. See it in Blast Wheels.</p><span class="more">View the case study <svg><use href="#arrow"/></svg></span></a><div class="glass" style="border-color:rgba(34,224,245,.5)"><span class="gic"><svg><use href="#search"/></svg></span><h3>Not sure what you need?</h3><p>Tell us where your project is today and we will recommend the right way to work together.</p><button class="more" data-contact style="background:none;border:0;padding:0;cursor:pointer;font-size:inherit">Ask our team <svg><use href="#arrow"/></svg></button></div></div></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">Technology</span><h2>The Tools Behind the Work</h2><p class="lede">We choose technology for the project, not the other way around. These are the tools we use most.</p></div><div class="glass" style="max-width:900px"><table class="tbl"><tbody><tr><th scope="row">Engine</th><td>Unity</td></tr><tr><th scope="row">Multiplayer</th><td>Photon Fusion, PUN2, Photon Voice</td></tr><tr><th scope="row">Backend</th><td>PlayFab, Firebase, Node.js, Supabase</td></tr><tr><th scope="row">Analytics</th><td>AppsFlyer, Tenjin</td></tr><tr><th scope="row">Platforms</th><td>iOS, Android, PC, WebGL, Quest</td></tr><tr><th scope="row">Web3</th><td>Sui, Move, thirdweb, ChainSafe</td></tr></tbody></table></div></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">Related work</span><h2>See the Services in Practice</h2></div><div class="g3"><a class="glass ccard" href="/work/highnoon/" data-tags="mobile multiplayer backend"><div class="ci"><Picture src={i_02_highnoon} formats={["avif","webp"]} fallbackFormat="webp" widths={[400, 720, 1080]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 560px" loading="lazy" decoding="async" alt="HighNoon key art" /></div>
  <div class="cb"><div class="tags"><span class="tag2">Mobile competitive game</span><span class="tag2">Mobile</span></div><h3 style="font-size:22px;margin:0 0 10px">HighNoon</h3><ul class="facts"><li>Real-time 1v1 multiplayer</li><li>PlayFab services</li><li>In-app purchases and advertising</li></ul><span class="more">View case study <svg><use href="#arrow"/></svg></span></div></a><a class="glass ccard" href="/work/blast-wheels/" data-tags="multiplayer backend"><div class="ci"><Picture src={i_03_blast_wheels} formats={["avif","webp"]} fallbackFormat="webp" widths={[400, 720, 1080]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 560px" loading="lazy" decoding="async" alt="Blast Wheels key art" /></div>
  <div class="cb"><div class="tags"><span class="tag2">Vehicle combat game</span></div><h3 style="font-size:22px;margin:0 0 10px">Blast Wheels</h3><ul class="facts"><li>PvP and PvE vehicle gameplay</li><li>Unity development</li><li>Sui blockchain with Move and Node</li></ul><span class="more">View case study <svg><use href="#arrow"/></svg></span></div></a></div></div></section>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import i_01_gamisodes from '../../assets/img/01-gamisodes.webp';
import i_02_highnoon from '../../assets/img/02-highnoon.webp';
---
<Layout title={"Complete Game Development | Game Nock"} description={"Complete game development from planning to launch: technical planning, prototyping, gameplay, backend, QA and store release in Unity."} active="services" contact={true}>
<section class="pg-hero"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/services/">Services</a><span aria-hidden="true">/</span><span aria-current="page">Complete Game Development</span></nav><span class="eyebrow">Complete Game Development</span><h1>Complete Game Development from Planning to Launch.</h1><p class="lede">For founders and studios who need one accountable partner to plan, build and release their game.</p><div class="ctas"><button class="btn btn-primary mag" data-contact>Discuss Your Project <svg><use href="#arrow"/></svg></button><a class="btn btn-wa-solid" href="https://wa.me/923184142473" target="_blank" rel="noopener"><svg><use href="#whatsapp"/></svg> Chat on WhatsApp</a></div></div></section><section class="sp "><div class="wrap"><div class="g2"><div class="glass"><span class="eyebrow">Problems we solve</span><h2 class="ttl">When Teams Call Us</h2><ul class="facts"><li>You have a concept or design document but no development team</li><li>Your studio needs a partner to own full production</li><li>An existing prototype needs to become a commercial product</li><li>Art, development, QA and store release all need to be coordinated</li></ul></div>
      <div class="glass"><span class="eyebrow">Deliverables</span><h2 class="ttl">What You Receive</h2><ul class="facts"><li>Technical planning and architecture</li><li>Prototype development</li><li>Gameplay systems</li><li>UI implementation</li><li>Backend and multiplayer</li><li>Art integration</li><li>Quality assurance</li><li>Store preparation and submission</li><li>Post-launch support</li></ul></div></div></div></section><section class="sp "><div class="wrap"><div class="g2"><div class="glass"><span class="eyebrow">Project stages</span><h2 class="ttl">Where This Fits</h2><ul class="facts"><li>Approved concept or game design document</li><li>Early prototype that needs a production team</li><li>Paused project that needs a new team to finish it</li></ul></div>
      <div class="glass"><span class="eyebrow">Technologies</span><h2 class="ttl">What We Use</h2><table class="tbl"><tbody><tr><th scope="row">Engine</th><td>Unity</td></tr><tr><th scope="row">Backend</th><td>PlayFab, Firebase, Node.js, Supabase</td></tr><tr><th scope="row">Multiplayer</th><td>Photon Fusion, PUN2</td></tr><tr><th scope="row">Platforms</th><td>iOS, Android, PC, WebGL, Quest</td></tr></tbody></table></div></div></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">Process</span><h2>How We Deliver</h2></div><ol class="ksteps"><li class="glass"><h3>Review</h3><p>We study your project and goals.</p></li><li class="glass"><h3>Plan</h3><p>Scope, team, milestones and risks.</p></li><li class="glass"><h3>Build</h3><p>Iterative development with regular builds.</p></li><li class="glass"><h3>Test</h3><p>QA on target devices.</p></li><li class="glass"><h3>Deliver</h3><p>Release, handover and support.</p></li></ol><p style="margin-top:24px"><a class="link" href="/how-we-work/">See the full process <svg><use href="#arrow"/></svg></a></p></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">Engagement model</span><h2>How the Engagement Works</h2></div><div class="glass prose" style="max-width:900px"><h3>Milestone-based fixed scope</h3><p>Best when the design is clear. We agree the scope, milestones and deliverables up front, and each milestone ends with a playable build you review.</p><h3>Dedicated team</h3><p>Best when the design will evolve. You get a stable team for an agreed period, and we plan work sprint by sprint with you.</p><p>We don’t publish fixed prices, because game scope varies widely. After reviewing your documents we provide a written estimate with assumptions and risks listed.</p></div></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">Related work</span><h2>Projects Where We Did This</h2></div><div class="g3"><a class="glass ccard" href="/work/gamisodes-baby-einstein/" data-tags="mobile backend"><div class="ci"><Picture src={i_01_gamisodes} formats={["avif","webp"]} fallbackFormat="webp" widths={[400, 720, 1080]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 560px" loading="lazy" decoding="async" alt="Gamisodes / Baby Einstein key art" /></div>
  <div class="cb"><div class="tags"><span class="tag2">Interactive entertainment</span><span class="tag2">iOS and Android</span></div><h3 style="font-size:22px;margin:0 0 10px">Gamisodes / Baby Einstein</h3><ul class="facts"><li>50+ mini-games</li><li>Unity, PlayFab, Tenjin and AppsFlyer</li><li>Deep links and ATT implementation</li></ul><span class="more">View case study <svg><use href="#arrow"/></svg></span></div></a><a class="glass ccard" href="/work/highnoon/" data-tags="mobile multiplayer backend"><div class="ci"><Picture src={i_02_highnoon} formats={["avif","webp"]} fallbackFormat="webp" widths={[400, 720, 1080]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 560px" loading="lazy" decoding="async" alt="HighNoon key art" /></div>
  <div class="cb"><div class="tags"><span class="tag2">Mobile competitive game</span><span class="tag2">Mobile</span></div><h3 style="font-size:22px;margin:0 0 10px">HighNoon</h3><ul class="facts"><li>Real-time 1v1 multiplayer</li><li>PlayFab services</li><li>In-app purchases and advertising</li></ul><span class="more">View case study <svg><use href="#arrow"/></svg></span></div></a></div></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">FAQ</span><h2>Common Questions</h2></div><div class="faq"><details class="glass"><summary>What do you need from us to start?</summary><p>A concept or design document, target platforms and your timeline. If documentation is thin, the first milestone can be a discovery and planning phase.</p></details><details class="glass"><summary>Who owns the code and assets?</summary><p>You do. Ownership transfers under the contract, and you receive the full project repository.</p></details><details class="glass"><summary>Can you work with our artists?</summary><p>Yes. We can integrate art from your team or a separate studio, or coordinate art production ourselves.</p></details><details class="glass"><summary>Do you help after launch?</summary><p>Yes. Post-launch fixes, updates and live-ops support can continue under a separate agreement.</p></details></div></div></section>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import i_02_highnoon from '../../assets/img/02-highnoon.webp';
import i_03_blast_wheels from '../../assets/img/03-blast-wheels.webp';
---
<Layout title={"Co-Development | Game Nock"} description={"Unity co-development for studios and publishers: specialists, development pods and dedicated teams that work inside your pipeline."} active="services" contact={true}>
<section class="pg-hero"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/services/">Services</a><span aria-hidden="true">/</span><span aria-current="page">Co-Development</span></nav><span class="eyebrow">Co-Development</span><h1>Add Production Capacity Without Rebuilding Your Team.</h1><p class="lede">Unity specialists and compact, senior-led feature teams who work inside your production, tools and schedule.</p><div class="ctas"><button class="btn btn-primary mag" data-contact>Discuss Your Project <svg><use href="#arrow"/></svg></button><a class="btn btn-wa-solid" href="https://wa.me/923184142473" target="_blank" rel="noopener"><svg><use href="#whatsapp"/></svg> Chat on WhatsApp</a></div></div></section><section class="sp "><div class="wrap"><div class="g2"><div class="glass"><span class="eyebrow">Problems we solve</span><h2 class="ttl">When Teams Call Us</h2><ul class="facts"><li>A milestone is at risk and your team is at capacity</li><li>You are missing specific Unity expertise</li><li>Multiplayer needs to be implemented or stabilised</li><li>You need temporary team expansion</li><li>Performance or optimisation problems are blocking release</li><li>Platform delivery or backend feature work needs extra hands</li></ul></div>
      <div class="glass"><span class="eyebrow">Deliverables</span><h2 class="ttl">What You Receive</h2><ul class="facts"><li>Features built in your repository and branching model</li><li>Code that follows your conventions and review process</li><li>Regular builds and written progress updates</li><li>Documentation and handover for everything we touch</li></ul></div></div></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">Engagement options</span><h2>Choose the Right Level of Support</h2></div><div class="g2"><div class="glass"><span class="eyebrow">Who it is for</span><h2 class="ttl">Built for Teams Already Making Games</h2><ul class="facts"><li>Existing game studios</li><li>Publishers</li><li>Funded startups</li><li>Agencies that need a development partner</li></ul></div>
          <div style="display:grid;gap:16px" id="dedicated-team"><div class="glass"><h3>One specialist</h3><p>A senior Unity, multiplayer or backend engineer joins your team.</p></div><div class="glass"><h3>Small development pod</h3><p>Two to four developers working on a defined area of your game.</p></div><div class="glass"><h3>Managed feature team</h3><p>We own a feature end to end, from design review to QA, and hand it back integrated.</p></div><div class="glass"><h3>Dedicated monthly team</h3><p>A stable team reserved for your project on a monthly basis.</p></div></div></div></div></section><section class="sp "><div class="wrap"><div class="g2"><div class="glass"><span class="eyebrow">Project stages</span><h2 class="ttl">Where This Fits</h2><ul class="facts"><li>Production with a looming milestone</li><li>Pre-launch polish and optimisation</li><li>Live games that need ongoing feature work</li></ul></div>
      <div class="glass"><span class="eyebrow">Technologies</span><h2 class="ttl">What We Use</h2><table class="tbl"><tbody><tr><th scope="row">Engine</th><td>Unity</td></tr><tr><th scope="row">Multiplayer</th><td>Photon Fusion, PUN2, Photon Voice</td></tr><tr><th scope="row">Backend</th><td>PlayFab, Firebase, Node.js, Supabase</td></tr><tr><th scope="row">Collaboration</th><td>Git, Jira or ClickUp, Slack or Teams</td></tr></tbody></table></div></div></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">Process</span><h2>How We Deliver</h2></div><ol class="ksteps"><li class="glass"><h3>Review</h3><p>We study your project and goals.</p></li><li class="glass"><h3>Plan</h3><p>Scope, team, milestones and risks.</p></li><li class="glass"><h3>Build</h3><p>Iterative development with regular builds.</p></li><li class="glass"><h3>Test</h3><p>QA on target devices.</p></li><li class="glass"><h3>Deliver</h3><p>Release, handover and support.</p></li></ol><p style="margin-top:24px"><a class="link" href="/how-we-work/">See the full process <svg><use href="#arrow"/></svg></a></p></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">Related work</span><h2>Projects Where We Did This</h2></div><div class="g3"><a class="glass ccard" href="/work/highnoon/" data-tags="mobile multiplayer backend"><div class="ci"><Picture src={i_02_highnoon} formats={["avif","webp"]} fallbackFormat="webp" widths={[400, 720, 1080]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 560px" loading="lazy" decoding="async" alt="HighNoon key art" /></div>
  <div class="cb"><div class="tags"><span class="tag2">Mobile competitive game</span><span class="tag2">Mobile</span></div><h3 style="font-size:22px;margin:0 0 10px">HighNoon</h3><ul class="facts"><li>Real-time 1v1 multiplayer</li><li>PlayFab services</li><li>In-app purchases and advertising</li></ul><span class="more">View case study <svg><use href="#arrow"/></svg></span></div></a><a class="glass ccard" href="/work/blast-wheels/" data-tags="multiplayer backend"><div class="ci"><Picture src={i_03_blast_wheels} formats={["avif","webp"]} fallbackFormat="webp" widths={[400, 720, 1080]} sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 560px" loading="lazy" decoding="async" alt="Blast Wheels key art" /></div>
  <div class="cb"><div class="tags"><span class="tag2">Vehicle combat game</span></div><h3 style="font-size:22px;margin:0 0 10px">Blast Wheels</h3><ul class="facts"><li>PvP and PvE vehicle gameplay</li><li>Unity development</li><li>Sui blockchain with Move and Node</li></ul><span class="more">View case study <svg><use href="#arrow"/></svg></span></div></a></div></div></section><section class="sp "><div class="wrap"><div class="sec-head"><span class="eyebrow">FAQ</span><h2>Common Questions</h2></div><div class="faq"><details class="glass"><summary>How quickly can someone start?</summary><p>Usually within one to two weeks, depending on the skills needed and the size of the team.</p></details><details class="glass"><summary>Will your developers use our tools?</summary><p>Yes. We work in your repository, task tracker and chat, and join your stand-ups and reviews.</p></details><details class="glass"><summary>What time zones do you cover?</summary><p>We work worldwide and arrange working hours to overlap with your team for meetings and reviews.</p></details><details class="glass"><summary>Can we scale the team up or down?</summary><p>Yes. Team size can change between phases with reasonable notice.</p></details></div></div></section>
</Layout>

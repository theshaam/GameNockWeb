---
import '../styles/global.css';
import Icons from '../components/Icons.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';

interface Props { title: string; description: string; page?: string; active?: string; contact?: boolean; schema?: object[] }
const { title, description, page = 'sub', active = '', contact = true, schema = [] } = Astro.props;
const site = Astro.site ?? new URL('https://gamenock.com');
const canonical = new URL(Astro.url.pathname, site).href;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Game Nock', url: site.href, logo: new URL('/favicon.png', site).href,
  email: 'contact@gamenock.com', telephone: '+923184142473', description: 'Game development partner providing complete development, co-development and specialised engineering.' };
const ld = [org, ...schema];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.png">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Game Nock">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&display=swap">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body>
<Icons />
<div class="loader" id="loader" aria-hidden="true"><div><img class="loader-logo" src="/img/logo-mark.png" alt=""><b>Game Nock</b></div></div>
<div class="backdrop" aria-hidden="true" id="journey"></div>
<canvas id="sky" aria-hidden="true"></canvas>
<div id="veil" aria-hidden="true"></div>
<div class="nebula" aria-hidden="true"></div>
<div class="spot" id="spot" aria-hidden="true"></div>

<Header active={active} />

<main id="top" data-page={page}>
<div class="rail l" id="railL" aria-hidden="true"></div><div class="rail r" id="railR" aria-hidden="true"></div>
<div class="neon" id="neon" aria-hidden="true"></div>
<slot />
{contact && <Contact />}
</main>

<Footer />

<a class="wa-float" href="https://wa.me/923184142473" target="_blank" rel="noopener" aria-label="Chat with Game Nock on WhatsApp"><svg><use href="#whatsapp"/></svg><span class="wa-tip">Chat with us</span></a>
<button class="to-top" id="toTop" aria-label="Back to top"><svg><use href="#arrow"/></svg></button>

<div class="modal" id="modal" hidden role="dialog" aria-modal="true" aria-labelledby="mTitle"><div class="modal-box" id="mBox"></div></div>

<script is:inline src="/js/site.js" defer></script>
</body>
</html>

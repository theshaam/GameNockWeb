---
import '../styles/global.css';
import Icons from '../components/Icons.astro';
import Intro from '../components/Intro.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import defaultOgImage from '../assets/img/hero-team.webp';

interface Props { title: string; description: string; page?: string; active?: string; contact?: boolean; schema?: object[]; image?: { src: string } | string; ogType?: string }
const { title, description, page = 'sub', active = '', contact = true, schema = [], image, ogType = 'website' } = Astro.props;
const site = Astro.site ?? new URL('https://gamenock.com');
// trailingSlash is set to 'ignore' in astro.config.mjs, so a page is reachable
// both with and without a trailing slash and Astro won't redirect either way.
// Every internal link on the site uses the slashed form, so normalize the
// canonical to match it too -- otherwise a stray external link to the
// non-slash variant would self-canonicalize instead of consolidating to the
// one real URL, defeating the point of having a canonical tag at all.
const normalizedPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(normalizedPath, site).href;
// Falls back to the homepage hero art so every page shares SOME preview image
// when linked on WhatsApp/Slack/X/etc, even ones with no obvious page-specific
// art of their own (about, contact, services, genre pages).
const ogImage = new URL(typeof image === 'string' ? image : (image?.src ?? defaultOgImage.src), site).href;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: 'Game Nock', url: site.href, logo: new URL('/favicon.png', site).href,
  email: 'contact@gamenock.com', telephone: '+923184142473', description: 'Game development partner providing complete development, co-development and specialised engineering.',
  // Lets Google connect this Organization entity to the same social profiles
  // already linked from the footer, instead of having no link between them.
  sameAs: ['https://www.linkedin.com/company/gamenock/', 'https://www.instagram.com/gamenock/', 'https://www.facebook.com/p/Gamenock-61551880780001/', 'https://discord.gg/rCVwhpRT4'] };
const ld = [org, ...schema];
---
<!doctype html>
<html lang="en" class="hero-ready">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>{title}</title>
<style is:inline>
  html{background:#030819}
  body{margin:0;background:#030819}
</style>
<script is:inline>
  // Restore the previous sky before the page paints on reload/history return.
  // A normal visit still starts with the page's usual dawn sky.
  (() => {
    const type = performance.getEntriesByType('navigation')[0]?.type;
    if (type !== 'reload' && type !== 'back_forward') return;
    try {
      const saved = JSON.parse(sessionStorage.getItem('gamenock:sky:' + location.pathname) || 'null');
      if (!saved || !Number.isFinite(saved.progress) || saved.progress < 0 || saved.progress > 1) return;
      const root = document.documentElement;
      root.dataset.skyProgress = String(saved.progress);
      if (typeof saved.background === 'string' && CSS.supports('background-image', saved.background)) root.style.setProperty('--initial-sky', saved.background);
      if (Number.isFinite(saved.veil)) root.style.setProperty('--initial-veil', String(saved.veil));
      if (Number.isFinite(saved.nebula)) root.style.setProperty('--initial-nebula', String(saved.nebula));
    } catch {}
  })();
</script>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#030819">
<link rel="preload" as="image" href="/img/logo-mark.png" fetchpriority="high">
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="Game Nock">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=DM+Sans:wght@400;500;600&display=swap"></noscript>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body>
<Icons />
<Intro />
<div class="backdrop" aria-hidden="true" id="journey"></div>
<canvas id="sky" aria-hidden="true"></canvas>
<div id="veil" aria-hidden="true"></div>
<div class="nebula" aria-hidden="true"></div>
<div class="spot" id="spot" aria-hidden="true"></div>

<Header active={active} />

<main id="top" data-page={page}>
<div class="rail l" id="railL" aria-hidden="true"></div><div class="rail r" id="railR" aria-hidden="true"></div>
<div class="neon" id="neon" aria-hidden="true"></div>
<slot />
{contact && <Contact />}
</main>

<Footer />

<a class="wa-float" href="https://wa.me/923184142473" target="_blank" rel="noopener" aria-label="Chat with Game Nock on WhatsApp"><svg><use href="#whatsapp"/></svg><span class="wa-tip">Chat with us</span></a>
<button class="to-top" id="toTop" aria-label="Back to top"><svg><use href="#arrow"/></svg></button>

<div class="modal" id="modal" hidden role="dialog" aria-modal="true" aria-labelledby="mTitle"><div class="modal-box" id="mBox"></div></div>

<script is:inline src="/js/site.js" defer></script>

</body>
</html>

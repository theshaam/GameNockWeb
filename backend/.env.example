# Copy this file to .env and fill in real values. Never commit .env.

# MySQL connection (create the database + user via cPanel's "MySQL Database Wizard")
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gamenock_backend
DB_USER=gamenock_backend
DB_PASSWORD=changeme

# Long random string used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=changeme

# Comma-separated list of origins allowed to call the public API from the browser.
# Set this to your live site's URL(s), e.g. https://gamenock.com,https://www.gamenock.com
CORS_ORIGIN=http://localhost:4321

# Port Passenger/Node should listen on. cPanel's "Setup Node.js App" sets PORT itself;
# this value is only used when running the backend outside cPanel (e.g. locally).
PORT=4000

# SMTP credentials for the "new enquiry" notification email. If any of SMTP_HOST/
# SMTP_USER/SMTP_PASS or NOTIFY_TO is left unset, notifications are silently skipped
# and enquiries still save normally -- email is a notification, not the source of truth.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465 (implicit TLS), false for port 587 (STARTTLS)
SMTP_SECURE=false
# Optional: defaults to SMTP_USER if unset
SMTP_FROM=

# Inbox that should receive a "New enquiry" email for every saved lead.
NOTIFY_TO=

# Optional: post a "New enquiry" message to a Discord channel for every saved lead.
# Create one via that channel's Settings -> Integrations -> Webhooks -> New Webhook,
# then copy its URL here. Leave blank to skip Discord notifications entirely.
DISCORD_WEBHOOK_URL=
